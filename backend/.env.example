# ---------------------------------------------------------------------------
# Flight search
# ---------------------------------------------------------------------------
# auto     -> Duffel if DUFFEL_ACCESS_TOKEN is set, else Tequila, else Amadeus.
#             Fails closed (no silent mock) when nothing is configured.
# duffel | tequila | amadeus | mock
FLIGHT_PROVIDER=duffel

# Duffel Flights API — https://app.duffel.com  (test tokens start with duffel_test_)
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

# SerpApi Google Flights — resolves "Book on airline website" to the carrier's own page.
SERPAPI_API_KEY=

# Kiwi.com Tequila affiliate metasearch (https://tequila.kiwi.com)
TEQUILA_API_KEY=
TEQUILA_BASE_URL=https://api.tequila.kiwi.com

# Amadeus Self-Service (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use https://api.amadeus.com for production keys
AMADEUS_BASE_URL=https://test.api.amadeus.com

DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Automated check-in
# ---------------------------------------------------------------------------
# Flyo AI Web Check-in API (primary strategy). Leave blank to go straight to
# the Playwright fallback bot.
FLYO_API_KEY=
FLYO_BASE_URL=https://api.flyo.ai
# Shared secret used to verify the X-Flyo-Signature header (HMAC-SHA256 of the
# raw request body). Leave blank to accept unsigned webhooks (local dev only).
FLYO_WEBHOOK_SECRET=

# Publicly reachable base URL of this API, used to build the webhook callback
# URL and absolute boarding-pass links (e.g. an ngrok URL in development).
PUBLIC_BASE_URL=http://localhost:8000

# Hours before departure at which check-in is triggered.
CHECKIN_LEAD_HOURS=24

# Playwright fallback bot
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./concierge.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://concierge:secret@db.example.com:5432/concierge

# Comma-separated list of allowed CORS origins, or * for any.
CORS_ORIGINS=*

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Authenticated web app (v1)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
APP_URL=http://127.0.0.1:5173
DEMO_ENABLED=true
LEGACY_API_ENABLED=false
AUTO_CHECKIN_ENABLED=false
LIVE_CHECKOUT_ENABLED=false
DUFFEL_CARDS_APPROVED=false
# Airline codes must be confirmed in the account's card-payment approval.
DUFFEL_CARD_AIRLINES=
ALLOWED_EMAILS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_GOOGLE_ENABLED=false
AUTH_EMAIL_OTP_ENABLED=false
# Generate a Fernet key locally; keep the value in the deployment secret store.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8001/api/v1/connections/gmail/callback
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FORWARDING_DOMAIN=
NOTIFICATION_FROM=
GOOGLE_PLACES_API_KEY=
SENTRY_DSN=
SEARCH_DAILY_LIMIT=100
PLACES_DAILY_LIMIT=30
SESSION_DAYS=7
