# ---------------------------------------------------------------------------
# Flight search
# ---------------------------------------------------------------------------
# auto     -> use Tequila if TEQUILA_API_KEY is set, else Amadeus if its
#             credentials are set, else built-in mock data
# tequila | amadeus | mock -> force a provider
FLIGHT_PROVIDER=auto

# Kiwi.com Tequila affiliate metasearch (https://tequila.kiwi.com)
TEQUILA_API_KEY=
TEQUILA_BASE_URL=https://api.tequila.kiwi.com

# Amadeus Self-Service (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use https://api.amadeus.com for production keys
AMADEUS_BASE_URL=https://test.api.amadeus.com

DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Automated check-in
# ---------------------------------------------------------------------------
# Flyo AI Web Check-in API (primary strategy). Leave blank to go straight to
# the Playwright fallback bot.
FLYO_API_KEY=
FLYO_BASE_URL=https://api.flyo.ai
# Shared secret used to verify the X-Flyo-Signature header (HMAC-SHA256 of the
# raw request body). Leave blank to accept unsigned webhooks (local dev only).
FLYO_WEBHOOK_SECRET=

# Publicly reachable base URL of this API, used to build the webhook callback
# URL and absolute boarding-pass links (e.g. an ngrok URL in development).
PUBLIC_BASE_URL=http://localhost:8000

# Hours before departure at which check-in is triggered.
CHECKIN_LEAD_HOURS=24

# Playwright fallback bot
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./concierge.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://concierge:secret@db.example.com:5432/concierge

# Comma-separated list of allowed CORS origins, or * for any.
CORS_ORIGINS=*

LOG_LEVEL=INFO
